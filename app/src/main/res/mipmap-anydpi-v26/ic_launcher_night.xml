<?xml version="1.0" encoding="utf-8"?>
<!-- 夜间启动图标（别名 .MainActivityIconNight 专用，不带 night 限定符）：哑光中性黑底板 #171717，前景沿用日间矢量（白贴字 + 双水滴）。日夜间切换由 AppIconUtil 切换别名实现，启动器不读 -night 资源。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_night_background"/>
    <foreground android:drawable="@drawable/ic_launcher_new_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_new_monochrome" />
</adaptive-icon>
